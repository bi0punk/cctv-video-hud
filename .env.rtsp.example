# Configuración mínima solo RTSP
# cp .env.rtsp.example .env

APP_HOST=0.0.0.0
APP_PORT=5000
APP_TZ=America/Santiago
APP_DEBUG=false

CAMERA_SOURCE=rtsp://admin:123456@192.168.1.154:554/live/ch00
# CAMERA_SOURCE=demo

FRAME_WIDTH=1280
FRAME_HEIGHT=720
JPEG_QUALITY=82
FRAME_SLEEP_MS=10
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;5000000|max_delay;500000

STATION_NAME=CÁMARA
STATION_LAT=-28.5700
STATION_LON=-70.7600

WEATHER_ENABLED=true
WEATHER_TTL_SECONDS=300
OPEN_METEO_TIMEOUT_SECONDS=8
ALLOW_SIMULATED_FALLBACK=true
BURN_HUD_IN_FRAME=false
