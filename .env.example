# ============================================================
# OpenCV Sci-Tech HUD + RTSP + Open-Meteo
# Copia este archivo como .env:
#   cp .env.example .env
# ============================================================

APP_HOST=0.0.0.0
APP_PORT=5000
APP_TZ=America/Santiago
APP_DEBUG=false

# ============================================================
# CÁMARA REAL RTSP
# ============================================================
# Reemplaza usuario, password e IP.
CAMERA_SOURCE=rtsp://admin:123456@192.168.1.154:554/live/ch00

# Substream, más liviano para dashboard:
# CAMERA_SOURCE=rtsp://admin:123456@192.168.1.154:554/live/ch01

# Webcam USB local:
# CAMERA_SOURCE=0

# Modo demo sin cámara:
# CAMERA_SOURCE=demo

FRAME_WIDTH=1280
FRAME_HEIGHT=720
JPEG_QUALITY=82
FRAME_SLEEP_MS=10

# RTSP por TCP: más estable en redes reales.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;5000000|max_delay;500000

# ============================================================
# ESTACIÓN / COORDENADAS
# ============================================================
STATION_NAME=ESTACIÓN VALLENAR
STATION_LAT=-28.5700
STATION_LON=-70.7600

# ============================================================
# OPEN-METEO (datos meteorológicos reales sin API key)
# ============================================================
# Obtiene: temperatura, humedad, presión, viento, AQI, PM2.5, PM10, UV, nubes, precipitación
WEATHER_ENABLED=true
WEATHER_TTL_SECONDS=300
OPEN_METEO_TIMEOUT_SECONDS=8
ALLOW_SIMULATED_FALLBACK=true

# ============================================================
# HUD
# ============================================================
# false = HUD sci-tech con CSS sobre el video (recomendado).
# true  = HUD básico dibujado dentro del JPEG con OpenCV.
BURN_HUD_IN_FRAME=false
